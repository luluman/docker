#!/usr/bin/env bash
# Server setup script for Debian and Ubuntu

set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

setup_sshd() {
    cat <<'EOF' >/etc/ssh/sshd_config.d/99-hardening.conf
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
SyslogFacility AUTH
LogLevel INFO
EOF

    # Validate config before reloading (set -e aborts if invalid)
    sshd -t
    systemctl reload ssh
}

install_docker() {
    if command -v docker &>/dev/null; then
        return 0
    fi

    # Loads $ID (debian or ubuntu) and $VERSION_CODENAME
    source /etc/os-release

    apt-get update
    apt-get install -y ca-certificates curl

    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL "https://download.docker.com/linux/${ID}/gpg" -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc

    cat <<EOF >/etc/apt/sources.list.d/docker.sources
Types: deb
URIs: https://download.docker.com/linux/${ID}
Suites: ${VERSION_CODENAME}
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOF

    apt-get update
    apt-get install -y \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin
}

# Install 24-bit color terminfo entries for the current user.
install_24bit_terminfo() {
    tic -x -o "${HOME}/.terminfo" "./scripts/terminfo-24bit.src"
}

install_24bit_terminfo
setup_sshd
install_docker
